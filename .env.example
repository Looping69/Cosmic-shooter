# APP_URL: The URL where this app is hosted.
# Used for self-referential links and API endpoints.
APP_URL="http://localhost:3000"

# VITE_WS_URL: WebSocket server URL.
# Set this when the frontend and backend are hosted on different services
# (e.g. frontend on Vercel, game server on Encore Cloud / Railway / Render).
# Examples:
#   Encore local dev:  VITE_WS_URL="ws://localhost:4000/connect"
#   Encore Cloud:      VITE_WS_URL="wss://staging-cosmic-shooter-XXXX.encr.app/connect"
#   Railway/Render:    VITE_WS_URL="wss://my-game-server.railway.app"
# If unset, the client connects to the same host as the frontend (local dev default).
# VITE_WS_URL=
